// Workers の設定。リソース本体（D1など）は infra/terraform で作り、出力されたIDをここに転記する
// 秘密情報はここに書かない（wrangler secret を使う）
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kokohima-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 公開されてよい設定値。秘密情報（GOOGLE_CLIENT_SECRET、APPLE_PRIVATE_KEY、JWT_SIGNING_KEYS、CALENDAR_TOKEN_KEYS）は
  // wrangler secret で設定する（ローカルは .dev.vars、E2Eは scripts/write-e2e-dev-vars.mjs が生成）
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "GOOGLE_CLIENT_ID": "",
    "APPLE_CLIENT_ID": "",
    "APPLE_TEAM_ID": "",
    "APPLE_KEY_ID": "",
    "JWT_CURRENT_KID": "local-1",
    "CALENDAR_TOKEN_CURRENT_KID": "local-1"
  },

  // outbox と定期の確認（docs/specs/T-06-calendar.md）。staging・prod の Queue の本体と退避キューは infra/terraform で作る（cloudflare_queue.outbox・outbox_dlq）
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "kokohima-local-outbox" }],
    "consumers": [{ "queue": "kokohima-local-outbox", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "kokohima-local-outbox-dlq" }]
  },
  // 1分ごと：outbox を Queue に流す・掃除。15分ごと：カレンダーの確認の割り当て
  "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },

  // ローカル開発（wrangler dev）。D1はローカルのSQLiteなのでIDは何でもよい
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kokohima-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "env": {
    // E2E用（ローカルでのみ使う）。テスト用ログインの経路を含むエントリを使う
    "e2e": {
      "main": "src/e2e/entry.ts",
      "vars": {
        "E2E_MODE": "1",
        "APP_ORIGIN": "http://localhost:5173",
        "GOOGLE_CLIENT_ID": "e2e-unused",
        "APPLE_CLIENT_ID": "e2e-unused",
        "APPLE_TEAM_ID": "e2e-unused",
        "APPLE_KEY_ID": "e2e-unused",
        "JWT_CURRENT_KID": "e2e-1",
        "CALENDAR_TOKEN_CURRENT_KID": "e2e-1"
      },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "kokohima-e2e-outbox" }],
        "consumers": [{ "queue": "kokohima-e2e-outbox", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "kokohima-e2e-outbox-dlq" }]
      },
      "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kokohima-e2e",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "staging": {
      // TODO: 本番の値に置き換える（ドメイン、Google／AppleのクライアントID）
      "vars": {
        "APP_ORIGIN": "https://staging.example.invalid",
        "GOOGLE_CLIENT_ID": "",
        "APPLE_CLIENT_ID": "",
        "APPLE_TEAM_ID": "",
        "APPLE_KEY_ID": "",
        "JWT_CURRENT_KID": "staging-1",
        "CALENDAR_TOKEN_CURRENT_KID": "staging-1"
      },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "kokohima-staging-outbox" }],
        "consumers": [{ "queue": "kokohima-staging-outbox", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "kokohima-staging-outbox-dlq" }]
      },
      "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kokohima-staging",
          // TODO: terraform output の D1 ID を転記する（infra/README.md の初回の手順6）
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "prod": {
      // TODO: 本番の値に置き換える（ドメイン、Google／AppleのクライアントID）
      "vars": {
        "APP_ORIGIN": "https://prod.example.invalid",
        "GOOGLE_CLIENT_ID": "",
        "APPLE_CLIENT_ID": "",
        "APPLE_TEAM_ID": "",
        "APPLE_KEY_ID": "",
        "JWT_CURRENT_KID": "prod-1",
        "CALENDAR_TOKEN_CURRENT_KID": "prod-1"
      },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "kokohima-prod-outbox" }],
        "consumers": [{ "queue": "kokohima-prod-outbox", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "kokohima-prod-outbox-dlq" }]
      },
      "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kokohima-prod",
          // TODO: terraform output の D1 ID を転記する（infra/README.md の初回の手順6）
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
