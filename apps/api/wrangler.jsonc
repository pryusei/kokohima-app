// Workers の設定。リソース本体（D1など）は infra/terraform で作り、出力されたIDをここに転記する
// 秘密情報はここに書かない（wrangler secret を使う）
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kokohima-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // global_fetch_strictly_public：自分のゾーンあての fetch も外からの要求として扱う（リンクのプレビューの取得。docs/specs/T-08-link-preview.md 決定事項3）
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // リクエストの URL にトークンが入る経路がある（OAuth のコールバックの code、.ics のパス）ので、
  // URL を含む呼び出しのログを出さない（docs/specs/T-06-calendar.md 決定事項14）。アプリの console のログは残る
  // issues：捕まえていない例外・5xx・error のログを Workers Issues にまとめ、自動の通知で Slack に送る（docs/specs/T-13-monitoring.md）。
  // 設定に書かないと次のデプロイで無効に戻る
  "observability": { "enabled": true, "logs": { "invocation_logs": false }, "issues": { "enabled": true } },
  // workers.dev とプレビューの URL を閉じる。各環境に継承される（docs/specs/T-12-release.md）。e2e の環境を誤ってデプロイしても公開されないように
  "workers_dev": false,
  "preview_urls": false,

  // 公開されてよい設定値。秘密情報（GOOGLE_CLIENT_SECRET、APPLE_PRIVATE_KEY、JWT_SIGNING_KEYS、CALENDAR_TOKEN_KEYS、
  // RESEND_API_KEY、VAPID_PRIVATE_KEY、NOTIFICATION_KEYS、CONTACT_SLACK_WEBHOOK_URL（問い合わせの Slack。T-24）、
  // AVATAR_URL_KEY（アイコンの画像の URL の署名の鍵。T-27））は
  // wrangler secret で設定する（ローカルは .dev.vars、E2Eは scripts/write-e2e-dev-vars.mjs が生成）
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "GOOGLE_CLIENT_ID": "",
    "APPLE_CLIENT_ID": "",
    "APPLE_TEAM_ID": "",
    "APPLE_KEY_ID": "",
    // Sign in with Apple を動かすか（"1" のときだけ）。最初のリリースは Google だけ（T-12）
    "APPLE_LOGIN_ENABLED": "1",
    "JWT_CURRENT_KID": "local-1",
    "CALENDAR_TOKEN_CURRENT_KID": "local-1",
    "NOTIFICATION_CURRENT_KID": "local-1",
    // VAPID の公開鍵（秘密鍵 VAPID_PRIVATE_KEY は wrangler secret）。TODO: 環境ごとの鍵の公開鍵に置き換える
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SUBJECT": "mailto:ops@example.invalid",
    "MAIL_FROM": "ここ暇 <notify@example.invalid>",
    // T-07 を有効にした時刻（Unixミリ秒）。これより前の通知だけの型の outbox の行は送らない
    "NOTIFICATION_START_AT": "1",
    // サービス全体の1日のメール数の上限
    "MAIL_DAILY_LIMIT": "90",
    // アプリ自身の登録ドメイン（カンマ区切り）。このドメインとサブドメインはリンクのプレビューで取りに行かない
    "LINK_PREVIEW_OWN_DOMAINS": "localhost"
  },

  // outbox と定期の確認（docs/specs/T-06-calendar.md）。staging・prod の Queue の本体と退避キューは infra/terraform で作る（cloudflare_queue.outbox・outbox_dlq）
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "kokohima-local-outbox" }],
    "consumers": [{ "queue": "kokohima-local-outbox", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "kokohima-local-outbox-dlq" }]
  },
  // 1分ごと：outbox を Queue に流す・掃除。15分ごと：カレンダーの確認の割り当て
  // キャッシュ（KV）とおおよその回数の上限（Rate Limiting）。docs/specs/T-10-idempotency-cache-ratelimit.md
  // Rate Limiting の namespace_id はアカウントの中で一意の整数。環境ごとに分ける（ローカル 1xxx・staging 2xxx・prod 3xxx）
  // リンクのプレビューの画像（docs/specs/T-08-link-preview.md「R2」）。本体は infra/terraform の kokohima-<env>-ogp-images
  "r2_buckets": [
    { "binding": "OGP_IMAGES", "bucket_name": "kokohima-local-ogp-images" },
    // アイコンの画像（docs/specs/T-27-avatar-upload.md「データ」）。本体は infra/terraform の kokohima-<env>-avatars
    { "binding": "AVATARS", "bucket_name": "kokohima-local-avatars" },
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "local-cache" }],
  "ratelimits": [
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_USER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },

  // ローカル開発（wrangler dev）。D1はローカルのSQLiteなのでIDは何でもよい
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kokohima-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "env": {
    // E2E用（ローカルでのみ使う）。テスト用ログインの経路を含むエントリを使う
    "e2e": {
      "main": "src/e2e/entry.ts",
      "vars": {
        "E2E_MODE": "1",
        "APP_ORIGIN": "http://localhost:5173",
        "GOOGLE_CLIENT_ID": "e2e-unused",
        "APPLE_CLIENT_ID": "e2e-unused",
        "APPLE_TEAM_ID": "e2e-unused",
        "APPLE_KEY_ID": "e2e-unused",
        // Sign in with Apple を動かすか（"1" のときだけ）。最初のリリースは Google だけ（T-12）
        "APPLE_LOGIN_ENABLED": "1",
        "JWT_CURRENT_KID": "e2e-1",
        "CALENDAR_TOKEN_CURRENT_KID": "e2e-1",
        "NOTIFICATION_CURRENT_KID": "e2e-1",
        // VAPID の公開鍵（秘密鍵 VAPID_PRIVATE_KEY は wrangler secret）。TODO: 環境ごとの鍵の公開鍵に置き換える
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "mailto:ops@example.invalid",
        "MAIL_FROM": "ここ暇 <notify@example.invalid>",
        // T-07 を有効にした時刻（Unixミリ秒）。これより前の通知だけの型の outbox の行は送らない
        "NOTIFICATION_START_AT": "1",
        // サービス全体の1日のメール数の上限（E2E は偽の配信で、同じ日に何度も流すので実質なしにする）
        "MAIL_DAILY_LIMIT": "1000000",
        // アプリ自身の登録ドメイン（カンマ区切り）。このドメインとサブドメインはリンクのプレビューで取りに行かない
        "LINK_PREVIEW_OWN_DOMAINS": "localhost"
      },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "kokohima-e2e-outbox" }],
        "consumers": [{ "queue": "kokohima-e2e-outbox", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "kokohima-e2e-outbox-dlq" }]
      },
      // リンクのプレビューの画像（docs/specs/T-08-link-preview.md「R2」）。本体は infra/terraform の kokohima-<env>-ogp-images
      "r2_buckets": [
        { "binding": "OGP_IMAGES", "bucket_name": "kokohima-e2e-ogp-images" },
        // アイコンの画像（docs/specs/T-27-avatar-upload.md「データ」）。本体は infra/terraform の kokohima-<env>-avatars
        { "binding": "AVATARS", "bucket_name": "kokohima-e2e-avatars" },
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "e2e-cache" }],
      "ratelimits": [
        { "name": "RL_PUBLIC", "namespace_id": "1101", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } }
      ],
      "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kokohima-e2e",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    // 本番と同じ形（ビルドした画面を静的アセットとして同じ Worker から出す）をローカルで確かめる環境（docs/specs/T-12-release.md「E2Eテスト」）。
    // デプロイしない。main は本番と同じ src/index.ts（テスト用ログインの経路を含まない）。
    // 秘密は dev:assets が scripts/write-e2e-dev-vars.mjs .dev.vars.assets で生成する（e2e の .dev.vars.e2e とは別のファイル）
    "assets": {
      "main": "src/index.ts",
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "vars": {
        "APP_ORIGIN": "http://localhost:8788",
        "GOOGLE_CLIENT_ID": "e2e-unused",
        "APPLE_CLIENT_ID": "e2e-unused",
        "APPLE_TEAM_ID": "e2e-unused",
        "APPLE_KEY_ID": "e2e-unused",
        // Sign in with Apple を動かすか（"1" のときだけ）。最初のリリースは Google だけ（T-12）
        "APPLE_LOGIN_ENABLED": "1",
        "JWT_CURRENT_KID": "e2e-1",
        "CALENDAR_TOKEN_CURRENT_KID": "e2e-1",
        "NOTIFICATION_CURRENT_KID": "e2e-1",
        // VAPID の公開鍵（秘密鍵 VAPID_PRIVATE_KEY は wrangler secret）。TODO: 環境ごとの鍵の公開鍵に置き換える
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "mailto:ops@example.invalid",
        "MAIL_FROM": "ここ暇 <notify@example.invalid>",
        // T-07 を有効にした時刻（Unixミリ秒）。これより前の通知だけの型の outbox の行は送らない
        "NOTIFICATION_START_AT": "1",
        // サービス全体の1日のメール数の上限（E2E は偽の配信で、同じ日に何度も流すので実質なしにする）
        "MAIL_DAILY_LIMIT": "1000000",
        // アプリ自身の登録ドメイン（カンマ区切り）。このドメインとサブドメインはリンクのプレビューで取りに行かない
        "LINK_PREVIEW_OWN_DOMAINS": "localhost"
      },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "kokohima-assets-outbox" }],
        "consumers": [{ "queue": "kokohima-assets-outbox", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "kokohima-assets-outbox-dlq" }]
      },
      // リンクのプレビューの画像（docs/specs/T-08-link-preview.md「R2」）。本体は infra/terraform の kokohima-<env>-ogp-images
      "r2_buckets": [
        { "binding": "OGP_IMAGES", "bucket_name": "kokohima-assets-ogp-images" },
        // アイコンの画像（docs/specs/T-27-avatar-upload.md「データ」）。本体は infra/terraform の kokohima-<env>-avatars
        { "binding": "AVATARS", "bucket_name": "kokohima-assets-avatars" },
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "assets-cache" }],
      "ratelimits": [
        { "name": "RL_PUBLIC", "namespace_id": "1201", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "1202", "simple": { "limit": 20, "period": 60 } }
      ],
      "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kokohima-assets",
          // ローカルの D1 は database_id ごとに分かれる。e2e（すべて0）と別の値にして、同時に起動する E2E とデータを共有しない
          "database_id": "00000000-0000-0000-0000-000000000a55",
          "migrations_dir": "migrations"
        }
      ]
    },
    "staging": {
      // 最初のリリースではデプロイしない（docs/specs/T-12-release.md 決定事項5）。作るときに prod と同じ形にそろえる
      "vars": {
        "APP_ORIGIN": "https://staging.example.invalid",
        "GOOGLE_CLIENT_ID": "",
        "APPLE_CLIENT_ID": "",
        "APPLE_TEAM_ID": "",
        "APPLE_KEY_ID": "",
        // Sign in with Apple を動かすか（"1" のときだけ）。最初のリリースは Google だけ（T-12）
        "APPLE_LOGIN_ENABLED": "0",
        "JWT_CURRENT_KID": "staging-1",
        "CALENDAR_TOKEN_CURRENT_KID": "staging-1",
        "NOTIFICATION_CURRENT_KID": "staging-1",
        // VAPID の公開鍵（秘密鍵 VAPID_PRIVATE_KEY は wrangler secret）。TODO: 環境ごとの鍵の公開鍵に置き換える
        "VAPID_PUBLIC_KEY": "",
        "VAPID_SUBJECT": "mailto:ops@example.invalid",
        "MAIL_FROM": "ここ暇 <notify@staging.example.invalid>",
        // T-07 を有効にした時刻（Unixミリ秒）。これより前の通知だけの型の outbox の行は送らない。未設定（空）の間はお知らせを作らない。TODO: 有効にするときに、その時刻を入れる
        "NOTIFICATION_START_AT": "",
        // サービス全体の1日のメール数の上限
        "MAIL_DAILY_LIMIT": "90",
        // アプリ自身の登録ドメイン（カンマ区切り）。このドメインとサブドメインはリンクのプレビューで取りに行かない TODO: 本番のドメインが決まったら置き換える
        "LINK_PREVIEW_OWN_DOMAINS": "example.invalid"
      },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "kokohima-staging-outbox" }],
        "consumers": [{ "queue": "kokohima-staging-outbox", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "kokohima-staging-outbox-dlq" }]
      },
      // TODO: terraform output の kv_namespace_id を転記する（infra/README.md の初回の手順6）
      // リンクのプレビューの画像（docs/specs/T-08-link-preview.md「R2」）。本体は infra/terraform の kokohima-<env>-ogp-images
      "r2_buckets": [
        { "binding": "OGP_IMAGES", "bucket_name": "kokohima-staging-ogp-images" },
        // アイコンの画像（docs/specs/T-27-avatar-upload.md「データ」）。本体は infra/terraform の kokohima-<env>-avatars
        { "binding": "AVATARS", "bucket_name": "kokohima-staging-avatars" },
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
      "ratelimits": [
        { "name": "RL_PUBLIC", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } }
      ],
      "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kokohima-staging",
          // TODO: terraform output の D1 ID を転記する（infra/README.md の初回の手順6）
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "prod": {
      // 本番（https://kokohima.app）。画面と API を同じ Worker から出す（docs/specs/T-12-release.md）
      // カスタムドメインの DNS の記録は Workers が作り、管理する（Terraform の DNS の管理の例外。決定事項6）
      "routes": [{ "pattern": "kokohima.app", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      // 画面（apps/web のビルド）。すべての要求をまず Worker のコードに通し、`/api/` 以外を ASSETS で返してヘッダーを付ける
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      // 本番でも Workers Issues を有効にする（docs/specs/T-13-monitoring.md）。invocation_logs は T-06 のとおり出さない
      "observability": { "enabled": true, "logs": { "invocation_logs": false }, "issues": { "enabled": true } },
      "vars": {
        "APP_ORIGIN": "https://kokohima.app",
        // 本番の OAuth クライアント ID（Google Cloud のプロジェクト kokohima の kokohima-prod。秘密ではない）
        "GOOGLE_CLIENT_ID": "220837211336-2pelj3laks6rvgoi61eeba4upluvpp98.apps.googleusercontent.com",
        "APPLE_CLIENT_ID": "",
        "APPLE_TEAM_ID": "",
        "APPLE_KEY_ID": "",
        // Sign in with Apple を動かすか（"1" のときだけ）。最初のリリースは Google だけ（T-12）
        "APPLE_LOGIN_ENABLED": "0",
        "JWT_CURRENT_KID": "prod-1",
        "CALENDAR_TOKEN_CURRENT_KID": "prod-1",
        "NOTIFICATION_CURRENT_KID": "prod-1",
        // VAPID の公開鍵（prod 用に作った鍵の組。秘密鍵 VAPID_PRIVATE_KEY は wrangler secret）
        "VAPID_PUBLIC_KEY": "BJe_MldfzmiyTEcmOTpIc7NH9aeg1fXlQOyNHLlS0dSjDO_XVI9YNPlk4E2rz0uWGlgnWob_pto9DycIRAv3KZs",
        "VAPID_SUBJECT": "mailto:ops@kokohima.app",
        "MAIL_FROM": "ここ暇 <notify@kokohima.app>",
        // T-07 を有効にした時刻（Unixミリ秒）。prod の D1 は新しく作り、古い outbox の行がないので "1"（T-12）
        "NOTIFICATION_START_AT": "1",
        // サービス全体の1日のメール数の上限
        "MAIL_DAILY_LIMIT": "90",
        // アプリ自身の登録ドメイン（カンマ区切り）。このドメインとサブドメインはリンクのプレビューで取りに行かない
        "LINK_PREVIEW_OWN_DOMAINS": "kokohima.app"
      },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "kokohima-prod-outbox" }],
        "consumers": [{ "queue": "kokohima-prod-outbox", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "kokohima-prod-outbox-dlq" }]
      },
      // リンクのプレビューの画像（docs/specs/T-08-link-preview.md「R2」）。本体は infra/terraform の kokohima-<env>-ogp-images
      "r2_buckets": [
        { "binding": "OGP_IMAGES", "bucket_name": "kokohima-prod-ogp-images" },
        // アイコンの画像（docs/specs/T-27-avatar-upload.md「データ」）。本体は infra/terraform の kokohima-<env>-avatars
        { "binding": "AVATARS", "bucket_name": "kokohima-prod-avatars" },
      ],
      // KV の ID は terraform output の kv_namespace_id（2026-11-23 に prod を apply）
      "kv_namespaces": [{ "binding": "CACHE", "id": "15794a8d567947cbb6660b89dee21024" }],
      "ratelimits": [
        { "name": "RL_PUBLIC", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "3002", "simple": { "limit": 20, "period": 60 } }
      ],
      "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kokohima-prod",
          // terraform output の d1_database_id（2026-11-23 に prod を apply）
          "database_id": "72a5b048-1c37-4862-9428-1bffbcb5f679",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
