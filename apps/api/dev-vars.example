# ローカル開発用の秘密情報のひな形。apps/api/.dev.vars にコピーして値を入れる（.dev.vars はコミットしない）
# JWT_SIGNING_KEYS の鍵は `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` で作る
JWT_SIGNING_KEYS='{"local-1":"<base64urlの32バイト>"}'
# カレンダーの更新用トークンの暗号化の鍵（作り方は同じ。JWT の鍵とは別の値にする）
CALENDAR_TOKEN_KEYS='{"local-1":"<base64urlの32バイト>"}'
GOOGLE_CLIENT_SECRET=
APPLE_PRIVATE_KEY=
# 通知（T-07）。VAPID の鍵は P-256 の鍵の組（秘密鍵は PKCS#8 の PEM を1行にして \n でつなぐ。公開鍵は wrangler の vars の VAPID_PUBLIC_KEY）
RESEND_API_KEY=
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# プッシュの購読の endpoint の暗号化の鍵（作り方は JWT の鍵と同じ。別の値にする）
NOTIFICATION_KEYS='{"local-1":"<base64urlの32バイト>"}'
# 問い合わせ（T-24）を届ける Slack の Incoming Webhook の URL。ローカルでは入れない（consumer は送らずに失敗し、ローカルのキューの中で退避するだけ）。
# 届くことを確かめるときは E2E の偽の Slack を使う
CONTACT_SLACK_WEBHOOK_URL=
# アイコンの画像の URL の署名の鍵（T-27。作り方は JWT の鍵と同じ。鍵だけを書き、JSON にしない）
AVATAR_URL_KEY=<base64urlの32バイト>
